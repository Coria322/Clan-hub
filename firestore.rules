rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Auth validations
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    // Role validations
    function isHouseholdMember(householdId) {
      return exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid));
    }
    
    function isHouseholdAdmin(householdId) {
      return get(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid)).data.role == 'admin';
    }

    // USERS COLLECTION
    match /users/{uid} {
      allow read: if isAuthenticated(); // Needed to query users for assigning and member details
      allow write: if isOwner(uid);
    }
    
    // HOUSEHOLDS COLLECTION
    match /households/{householdId} {
      // Any authenticated user can read it (needed to join using inviteCode)
      allow read: if isAuthenticated();
      // Only authenticated users can create it
      allow create: if isAuthenticated();
      // Only admin can update or delete
      allow update, delete: if isHouseholdAdmin(householdId);
      
      // MEMBERS SUBCOLLECTION
      match /members/{memberId} {
        // Miembros pueden leer la lista. El propio usuario puede leer su doc
        // para verificar si fue expulsado (splash screen).
        allow read: if isHouseholdMember(householdId) || isOwner(memberId);
        
        // Joining a household (create)
        // Allow if authenticated, and household has less than 6 members
        allow create: if isAuthenticated() && 
                      // Custom check: Count logic must ideally be checked in a function if possible,
                      // or just ensure we don't surpass 6. We can't query collections directly in rules easily for counts,
                      // so client must obey and security rule checks it using rules if possible.
                      // Note: Firestore now supports aggregated queries in rules (count() etc) but it's billed.
                      // For simplicity, we just allow create if they are authenticated. Complex limit validation
                      // should be done strictly on Cloud Functions or by trusted clients for V1.
                      true;
                      
        allow update: if isHouseholdAdmin(householdId);
        allow delete: if isHouseholdAdmin(householdId) || isOwner(memberId);
      }
      
      // CATEGORIES SUBCOLLECTION
      match /categories/{categoryId} {
        allow read: if isHouseholdMember(householdId);
        allow create: if isHouseholdMember(householdId);
        // Only admin can update or delete (to archive)
        allow update, delete: if isHouseholdAdmin(householdId);
      }
    }
    
    // TASKS COLLECTION
    // Nota: las queries (householdId + status + orderBy deadline/completedAt)
    // requieren índices compuestos definidos en firestore.indexes.json
    match /tasks/{taskId} {
      allow read: if isHouseholdMember(resource.data.householdId);
      allow create: if isAuthenticated()
                    && isHouseholdMember(request.resource.data.householdId)
                    && (request.resource.data.assignedTo == null || request.resource.data.assignedTo is string);
      allow update: if isHouseholdMember(resource.data.householdId)
                    && (
                      isHouseholdAdmin(resource.data.householdId) ||
                      resource.data.createdBy == request.auth.uid ||
                      (
                         (
                            resource.data.assignedTo == request.auth.uid || 
                            resource.data.assignedTo == null || 
                            resource.data.completedBy == request.auth.uid ||
                            (resource.data.deadline != null && resource.data.deadline < request.time)
                         ) 
                         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'completedBy', 'completedAt', 'weekKey'])
                      )
                    )
                    && (request.resource.data.assignedTo == null || request.resource.data.assignedTo is string);
      allow delete: if isHouseholdMember(resource.data.householdId)
                    && (
                      isHouseholdAdmin(resource.data.householdId) ||
                      (
                        resource.data.status == 'pending' &&
                        resource.data.createdBy == request.auth.uid
                      )
                    );
    }
  }
}
